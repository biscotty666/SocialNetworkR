combine_seasons <- function(net_list) {
edges <- do.call(
rbind,
lapply(net_list, function(g) {
igraph::as_data_frame(g, what = "edges")[, c("from", "to", "weight")]
})
)
}
combine_seasons <- function(net_list) {
edges <- do.call(
rbind,
lapply(net_list, function(g) {
igraph::as_data_frame(g, what = "edges")[, c("from", "to", "weight")]
})
)
edges <- aggregate(weight ~ from + to, data = edges, FUN = sum)
graph_from_data_frame(edges, directed = TRUE)
}
